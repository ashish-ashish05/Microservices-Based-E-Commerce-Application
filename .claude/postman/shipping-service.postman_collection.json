{
  "info": {
    "name": "Shipping Service API Tests",
    "description": "API tests for the Shipping Service. Prerequisites: Shipping Service must be running. Note: In a real scenario, ShippingMethod must be pre-seeded in the database.",
    "_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8095",
      "type": "string"
    },
    {
      "key": "shipmentId",
      "value": "",
      "type": "string"
    },
    {
      "key": "orderId",
      "value": "{{$randomUUID}}",
      "type": "string"
    },
    {
      "key": "shippingMethodId",
      "value": "{{$randomUUID}}",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "mock-token",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup",
      "item": [
        {
          "name": "Create Shipping Method",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"shippingMethodId\", json.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Express Delivery\",\n  \"cost\": 15.0,\n  \"estimatedDays\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipping-methods",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipping-methods"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Business Operations",
      "item": [
        {
          "name": "Create Shipment",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"shipmentId\", json.shipmentId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"shippingAddress\": \"123 Main St, New York, NY\",\n  \"shippingMethodId\": \"{{shippingMethodId}}\",\n  \"weight\": 2.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipments"
              ]
            }
          }
        },
        {
          "name": "Get Shipment Details",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains shipmentId\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.shipmentId).to.exist;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/shipments/{{shipmentId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipments",
                "{{shipmentId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "03 - Negative Tests",
      "item": [
        {
          "name": "Create Shipment - Duplicate Order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 409 Conflict\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"shippingAddress\": \"123 Main St, New York, NY\",\n  \"shippingMethodId\": \"{{shippingMethodId}}\",\n  \"weight\": 2.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipments"
              ]
            }
          }
        },
        {
          "name": "Create Shipment - Invalid Method",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{$randomUUID}}\",\n  \"shippingAddress\": \"123 Main St, New York, NY\",\n  \"shippingMethodId\": \"{{$randomUUID}}\",\n  \"weight\": 2.5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipments",
              "host": [
                "{{baseUrl}}"
              ],
                "path": [
                "api",
                "shipments"
              ]
            }
          }
        },
        {
          "name": "Create Shipment - Missing Fields",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 400 Bad Request\", function () {",
                      "    pm.response.to.have.status(400);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{$randomUUID}}\",\n  \"shippingAddress\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/shipments",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "shipments"
              ]
            }
          }
        }
      ]
    }
  ]
}
