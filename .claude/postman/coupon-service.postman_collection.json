{
  "info": {
    "name": "Coupon Service API Tests",
    "description": "Postman collection for testing the Coupon Service. Prerequisite: Coupon Service must be running on port 8085.",
    "_postman_id": "c8e7d9a0-1234-4b56-8c9d-e0f1g2h3i4j5",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "mock-token",
      "type": "string"
    },
    {
      "key": "lastCouponCode",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Setup",
      "item": [
        {
          "name": "Create Coupon",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set(\"lastCouponCode\", json.code);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"SUMMER2026\",\n  \"discountValue\": 20.0,\n  \"discountType\": \"PERCENTAGE\",\n  \"startDate\": \"2026-01-01T00:00:00\",\n  \"endDate\": \"2026-12-31T23:59:59\",\n  \"usageLimit\": 100,\n  \"minOrderValue\": 50.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "02 - Business Operations",
      "item": [
        {
          "name": "Validate Coupon",
          "event": [],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{lastCouponCode}}\",\n  \"userId\": \"user-123\",\n  \"orderValue\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "validate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Use Coupon",
          "event": [],
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/use?code={{lastCouponCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "use"
              ],
              "query": [
                {
                  "key": "code",
                  "value": "{{lastCouponCode}}"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Get Coupon Details",
          "event": [],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/coupons/{{lastCouponCode}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "{{lastCouponCode}}"
              ]
            }
          },
          "response": []
        }
      ]
    },
    {
      "name": "03 - Negative Tests",
      "item": [
        {
          "name": "Validate Expired Coupon",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"EXPIRED2024\",\n  \"userId\": \"user-123\",\n  \"orderValue\": 100.0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons/validate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons",
                "validate"
              ]
            }
          },
          "response": []
        },
        {
          "name": "Create Coupon - Duplicate Code",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{lastCouponCode}}\",\n  \"discountValue\": 10.0,\n  \"discountType\": \"FIXED\",\n  \"startDate\": \"2026-01-01T00:00:00\",\n  \"endDate\": \"2026-12-31T23:59:59\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/coupons",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "coupons"
              ]
            }
          },
          "response": []
        }
      ]
    }
  ]
}
