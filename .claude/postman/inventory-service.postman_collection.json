{
  "info": {
    "name": "Inventory Service API Tests",
    "_postman_id": "c3d4e5f6-a7b8-4c9d-0e1f-2a3b4c5d6e7f",
    "description": "Tests for the Inventory Service. Manages stock levels, reservations, and releases.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 - Setup",
      "item": [
        {
          "name": "Create Inventory",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n    \"productId\": \"{{productId}}\",\n    \"quantity\": 100\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/inventory",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "inventory"
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.test(\"Response contains productId\", function () {",
                  "    pm.expect(json.productId).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02 - CRUD",
      "item": [
        {
          "name": "Get Inventory",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/inventory/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
