{
  "info": {
    "name": "Cart Service API Tests",
    "description": "Postman collection for testing the Cart Service. Prerequisites: Product Service and Pricing Service must be running.",
    "_postman_id": "a1b2c3d4-e5f6-4a5b-8c9d-0e1f2a3b4c5d",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8085",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "user-123",
      "type": "string"
    },
    {
      "key": "productId",
      "value": "{{$randomUUID}}",
      "type": "string"
    },
    {
      "key": "accessToken",
      "value": "your-jwt-token-here",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01 - Happy Path",
      "item": [
        {
          "name": "Add Item to Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response contains userId\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.userId).to.eql(pm.collectionVariables.get(\"userId\"));",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 2\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}",
                "items"
              ]
            }
          }
        },
        {
          "name": "Get Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response contains items\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.items).to.be.an('array');",
                  "    pm.expect(json.items.length).to.be.at.least(1);",
                  "});",
                  "pm.test(\"Total price is present\", function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.totalPrice).to.exist;",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}"
              ]
            }
          }
        },
        {
          "name": "Update Item Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 5\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}/items/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}",
                "items",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Remove Item from Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}/items/{{productId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}",
                "items",
                "{{productId}}"
              ]
            }
          }
        },
        {
          "name": "Clear Cart",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 204\", function () {",
                  "    pm.response.to.have.status(204);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "02 - Negative Tests",
      "item": [
        {
          "name": "Add Item - Invalid Quantity",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 0\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}",
                "items"
              ]
            }
          }
        },
        {
          "name": "Add Item - Product Not Found",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Returns 404 Not Found\", function () {",
                  "    pm.response.to.have.status(404);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{accessToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": \"{{$randomUUID}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/carts/{{userId}}/items",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "carts",
                "{{userId}}",
                "items"
              ]
            }
          }
        }
      ]
    }
  ]
}
